# URL del proyecto de Supabase (Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Clave anónima / publishable (Settings → API). Nunca uses la service role acá.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Service role: solo servidor (API de bots y lecturas del dashboard).
# Nunca la expongas al browser ni la subas a git.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Email del dueño. Cualquier otra cuenta autenticada queda afuera.
OWNER_EMAIL=tu@email.com

# Opcional. Útil en local o si el redirect del magic link no coincide.
# En Vercel se infiere de VERCEL_URL si no está definida.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
